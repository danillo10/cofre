# Token do bot criado no @BotFather. Formato: 123456789:AAH...
# O Cofre lê texto e foto desse bot e lança o valor.
TELEGRAM_BOT_TOKEN=

# Opcional. Se ficar vazio, a primeira conversa privada fica gravada.
TELEGRAM_CHAT_ID=

# Chave da OpenAI para entender linguagem natural no Telegram.
OPENAI_API_KEY=
# Opcional. O padrão é gpt-4o.
OPENAI_MODEL=gpt-4o

PORT=8787
